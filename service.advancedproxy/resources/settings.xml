                <setting id="local_port" type="integer" label="32104" help="32105">
                    <level>0</level>
                    <default>1080</default>
                    <constraints>
                        <minimum>1</minimum>
                        <step>1</step>
                        <maximum>65535</maximum>
                    </constraints>
                    <control type="edit" format="integer">
                        <heading>32104</heading>
                    </control>
                </setting>
            </group>

            <group id="2" label="32003">
                <setting id="mode" type="integer" label="32106" help="32107">
                    <level>0</level>
