<?xml version="1.0" encoding="utf-8" ?>
<settings version="1">
    <section id="service.advancedproxy">

        <category id="connection" label="32000" help="32001">
            <group id="1" label="32002">
                <setting id="engine" type="integer" label="32100" help="32101">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="32102">0</option>
                            <option label="32103">1</option>
                        </options>
                    </constraints>
                    <control type="list" format="string">
                        <heading>32100</heading>
                    </control>
                </setting>
                <setting id="local_port" type="integer" label="32104" help="32105">
                    <level>0</level>
                    <default>1080</default>
                    <constraints>
                        <minimum>1</minimum>
                        <step>1</step>
                        <maximum>65535</maximum>
                    </constraints>
                    <control type="edit" format="integer">
                        <heading>32104</heading>
                    </control>
                </setting>
            </group>

            <group id="2" label="32003">
                <setting id="mode" type="integer" label="32106" help="32107">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="32108">0</option>
                            <option label="32109">1</option>
                        </options>
                    </constraints>
                    <control type="list" format="string">
                        <heading>32106</heading>
                    </control>
                </setting>
                <setting id="urltest_interval" type="string" label="32110" help="32111">
                    <level>0</level>
                    <default>3m</default>
                    <constraints>
                        <allowempty>false</allowempty>
                    </constraints>
                    <dependencies>
                        <dependency type="visible" setting="mode" operator="is">0</dependency>
                    </dependencies>
                    <control type="edit" format="string">
                        <heading>32110</heading>
                    </control>
                </setting>
                <setting id="urltest_tolerance" type="integer" label="32112" help="32113">
                    <level>0</level>
                    <default>50</default>
                    <constraints>
                        <minimum>0</minimum>
                        <step>10</step>
                        <maximum>2000</maximum>
                    </constraints>
                    <dependencies>
                        <dependency type="visible" setting="mode" operator="is">0</dependency>
                    </dependencies>
                    <control type="slider" format="integer">
                        <popup>true</popup>
                        <heading>32112</heading>
                    </control>
                </setting>
                <setting id="test_url" type="string" label="32114" help="32115">
                    <level>1</level>
                    <default>https://www.gstatic.com/generate_204</default>
                    <constraints>
                        <allowempty>false</allowempty>
                    </constraints>
                    <dependencies>
                        <dependency type="visible" setting="mode" operator="is">0</dependency>
                    </dependencies>
                    <control type="edit" format="string">
                        <heading>32114</heading>
                    </control>
                </setting>
                <setting id="interrupt_connections" type="boolean" label="32116" help="32117">
                    <level>1</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
            </group>

            <group id="3" label="32004">
                <setting id="open_profiles" type="action" label="32118" help="32119">
                    <level>0</level>
                    <data>RunAddon(service.advancedproxy)</data>
                    <control type="button" format="action">
                        <close>true</close>
                    </control>
                </setting>
            </group>
        </category>

        <category id="service" label="32010" help="32011">
            <group id="1" label="32012">
                <setting id="autostart" type="boolean" label="32120" help="32121">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="notify" type="boolean" label="32122" help="32123">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
            </group>
        </category>

        <category id="advanced" label="32020" help="32021">
            <group id="1" label="32022">
                <setting id="binary_custom_path" type="path" label="32126" help="32127">
                    <level>2</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                        <writable>false</writable>
                        <masking>executable</masking>
                    </constraints>
                    <control type="button" format="file">
                        <heading>32126</heading>
                    </control>
                </setting>
                <setting id="binary_platform_override" type="string" label="32134" help="32135">
                    <level>3</level>
                    <default>auto</default>
                    <constraints>
                        <allowempty>false</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>32134</heading>
                    </control>
                </setting>
            </group>

            <group id="2" label="32023">
                <setting id="skip_protocols" type="string" label="32124" help="32125">
                    <level>2</level>
                    <default>trojan,xhttp</default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>32124</heading>
                    </control>
                </setting>
                <setting id="log_level" type="integer" label="32128" help="32129">
                    <level>2</level>
                    <default>1</default>
                    <constraints>
                        <options>
                            <option label="32130">0</option>
                            <option label="32131">1</option>
                            <option label="32132">2</option>
                            <option label="32133">3</option>
                        </options>
                    </constraints>
                    <control type="list" format="string">
                        <heading>32128</heading>
                    </control>
                </setting>
            </group>
        </category>

    </section>
</settings>
