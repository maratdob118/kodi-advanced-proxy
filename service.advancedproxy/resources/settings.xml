<?xml version="1.0" encoding="utf-8" ?>
<settings version="1">
    <section id="service.advancedproxy">

        <category id="connection" label="32000" help="32001">
            <group id="1" label="32002">
                <setting id="engine" type="integer" label="32100" help="32101">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="32102">0</option>
                            <option label="32103">1</option>
                        </options>
                    </constraints>
                    <control type="list" format="string">
