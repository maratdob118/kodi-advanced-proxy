<?xml version="1.0" encoding="utf-8" ?>
<settings version="1">
    <section id="service.advancedproxy">

        <category id="engine" label="32100" help="32101">
            <group id="1" label="32101">
                <setting id="engine" type="integer" label="32102" help="32103">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="32104">0</option>
                            <option label="32105">1</option>
                        </options>
                    </constraints>
                    <control type="list" format="string">
                        <heading>32102</heading>
                    </control>
                </setting>
                <setting id="autostart" type="boolean" label="32106" help="32107">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="notify" type="boolean" label="32108" help="32109">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
            </group>
        </category>

        <category id="proxy" label="32110" help="32111">
            <group id="1" label="32111">
                <setting id="local_port" type="integer" label="32112" help="32113">
                    <level>0</level>
                    <default>1080</default>
                    <constraints>
                        <minimum>1</minimum>
                        <step>1</step>
                        <maximum>65535</maximum>
                    </constraints>
                    <control type="edit" format="integer">
                        <heading>32112</heading>
                    </control>
                </setting>
                <setting id="mode" type="integer" label="32114" help="32115">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="32116">0</option>
                            <option label="32117">1</option>
                        </options>
                    </constraints>
                    <control type="list" format="string">
                        <heading>32114</heading>
                    </control>
                </setting>
                <setting id="urltest_interval" type="string" label="32118" help="32119" parent="mode">
                    <level>0</level>
                    <default>3m</default>
                    <control type="edit" format="string">
                        <heading>32118</heading>
                    </control>
                    <dependencies>
                        <dependency type="visible" setting="mode" operator="is">0</dependency>
                    </dependencies>
                </setting>
                <setting id="urltest_tolerance" type="integer" label="32120" help="32121" parent="mode">
                    <level>0</level>
                    <default>50</default>
                    <constraints>
                        <minimum>0</minimum>
                        <step>10</step>
                        <maximum>10000</maximum>
                    </constraints>
                    <control type="edit" format="integer">
                        <heading>32120</heading>
                    </control>
                    <dependencies>
                        <dependency type="visible" setting="mode" operator="is">0</dependency>
                    </dependencies>
                </setting>
                <setting id="test_url" type="string" label="32122" help="32123" parent="mode">
                    <level>0</level>
                    <default>https://www.gstatic.com/generate_204</default>
                    <constraints>
                        <allowempty>false</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>32122</heading>
                    </control>
                    <dependencies>
                        <dependency type="visible" setting="mode" operator="is">0</dependency>
                    </dependencies>
                </setting>
                <setting id="interrupt_connections" type="boolean" label="32124" help="32125">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
            </group>
        </category>

        <category id="profiles" label="32130" help="32131">
            <group id="1" label="32131">
                <setting id="profiles_info" type="string" label="32132" help="32132">
                    <level>0</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="label" format="string"/>
                </setting>
                <setting id="action_add_profile" type="action" label="32133" help="32134">
                    <level>0</level>
                    <data>RunScript(service.advancedproxy,add)</data>
                    <control type="button" format="action">
                        <close>true</close>
                    </control>
                </setting>
                <setting id="action_manage_profiles" type="action" label="32135" help="32136">
                    <level>0</level>
                    <data>RunScript(service.advancedproxy,manage)</data>
                    <control type="button" format="action">
                        <close>true</close>
                    </control>
                </setting>
                <setting id="action_select_profile" type="action" label="32137" help="32138" parent="mode">
                    <level>0</level>
                    <data>RunScript(service.advancedproxy,select)</data>
                    <control type="button" format="action">
                        <close>true</close>
                    </control>
                    <dependencies>
                        <dependency type="visible" setting="mode" operator="is">1</dependency>
                    </dependencies>
                </setting>
                <setting id="action_test_profiles" type="action" label="32139" help="32140">
                    <level>0</level>
                    <data>RunScript(service.advancedproxy,test)</data>
                    <control type="button" format="action">
                        <close>true</close>
                    </control>
                </setting>
                <setting id="action_clear_profiles" type="action" label="32141" help="32142">
                    <level>0</level>
                    <data>RunScript(service.advancedproxy,clear)</data>
                    <control type="button" format="action">
                        <close>true</close>
                    </control>
                </setting>
            </group>
        </category>

        <category id="advanced" label="32150" help="32151">
            <group id="1" label="32151">
                <setting id="skip_protocols" type="string" label="32152" help="32153">
                    <level>0</level>
                    <default>trojan,xhttp</default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>32152</heading>
                    </control>
                </setting>
                <setting id="binary_custom_path" type="path" label="32162" help="32163">
                    <level>0</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                        <writable>false</writable>
                        <masking>executable</masking>
                    </constraints>
                    <control type="button" format="file">
                        <heading>32162</heading>
                    </control>
                </setting>
                <setting id="log_level" type="integer" label="32154" help="32155">
                    <level>0</level>
                    <default>1</default>
                    <constraints>
                        <options>
                            <option label="32156">0</option>
                            <option label="32157">1</option>
                            <option label="32158">2</option>
                            <option label="32159">3</option>
                        </options>
                    </constraints>
                    <control type="list" format="string">
                        <heading>32154</heading>
                    </control>
                </setting>
                <setting id="binary_platform_override" type="string" label="32160" help="32161">
                    <level>1</level>
                    <default>auto</default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>32160</heading>
                    </control>
                </setting>
            </group>
        </category>

    </section>
</settings>
