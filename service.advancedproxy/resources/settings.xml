                    <control type="edit" format="string">
                        <heading>32110</heading>
                    </control>
                </setting>
                <setting id="urltest_tolerance" type="integer" label="32112" help="32113">
                    <level>0</level>
                    <default>50</default>
                    <constraints>
                        <minimum>0</minimum>
                        <step>10</step>
                        <maximum>2000</maximum>
                    </constraints>
                    <dependencies>
                        <dependency type="visible" setting="mode" operator="is">0</dependency>
                    </dependencies>
                    <control type="slider" format="integer">
                        <popup>true</popup>
                        <heading>32112</heading>
                    </control>
                </setting>
                <setting id="test_url" type="string" label="32114" help="32115">
